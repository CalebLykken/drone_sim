{
  "name": "drone-sim-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser front end for drone_sim: the Python simulator runs in a Web Worker via Pyodide",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "local": "python3 src/python/server.py"
  },
  "dependencies": {
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@uiw/react-codemirror": "^4.25.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "three-stdlib": "^2.36.1",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
